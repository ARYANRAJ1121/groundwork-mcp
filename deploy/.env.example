# GitHub OAuth App credentials. Keep the real .env private; never commit secrets.
GROUNDWORK_OAUTH_GITHUB_CLIENT_ID=replace-me
GROUNDWORK_OAUTH_GITHUB_CLIENT_SECRET=replace-me

# Public HTTPS origin used by the MCP service (not the architecture-map site).
GROUNDWORK_OAUTH_GITHUB_BASE_URL=https://mcp.example.com

# Generate once and keep stable across restarts/redeploys (32+ characters).
GROUNDWORK_OAUTH_JWT_SIGNING_KEY=replace-with-a-long-random-secret
