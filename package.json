{
  "name": "groundwork-mcp",
  "version": "0.1.0",
  "description": "MCP server that clones, analyzes, and builds a citation-grounded knowledge base from any GitHub repository",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "groundwork-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "clean": "rimraf build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-analysis",
    "tree-sitter",
    "github",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "simple-git": "^3.27.0",
    "sql.js": "^1.12.0",
    "tree-sitter-wasms": "^0.1.13",
    "uuid": "^11.1.0",
    "web-tree-sitter": "^0.24.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
